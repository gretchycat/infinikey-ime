{
  "id": "mobile_symbol",
  "name": "Mobile Secondary Symbols",
  "version": "2.0",
  "author": "Gretchen Maculo",
  "description": "Dedicated Gboard-style mobile secondary symbols page.",
  "metadata": {
    "horizontalSpacing": 4,
    "verticalSpacing": 4,
    "defaultScreenMode": "FULL_WIDTH_DOCKED",
    "defaultHeightPercentage": 30,
    "showKeyPreview": false
  },
  "theme": {
    "fontFamily": "Monospace"
  },
  "styles": {
    "numberKey": {
      "cornerRadius": 8,
      "showPreview": false
    },
    "alphaKey": {
      "cornerRadius": 8,
      "showPreview": false
    },
    "modifierKey": {
      "cornerRadius": 8,
      "showPreview": false
    },
    "actionKey": {
      "cornerRadius": 8,
      "showPreview": false
    }
  },
  "rows": [
    {
      "id": 1,
      "splitIndex": 5,
      "keys": [
        { "label": "~", "alternates": ["`", "≈"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "~" } },
        { "label": "\\", "alternates": ["/"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "\\" } },
        { "label": "|", "alternates": ["¦"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "|" } },
        { "label": "^", "alternates": ["↑", "↗"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "^" } },
        { "label": "<", "alternates": ["«", "‹", "≤"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "<" } },
        { "label": ">", "alternates": ["»", "›", "≥"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": ">" } },
        { "label": "[", "alternates": ["("], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "[" } },
        { "label": "]", "alternates": [")"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "]" } },
        { "label": "{", "alternates": ["<"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "{" } },
        { "label": "}", "alternates": [">"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "}" } }
      ]
    },
    {
      "id": 2,
      "splitIndex": 5,
      "keys": [
        { "label": "€", "alternates": ["$", "¢"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "€" } },
        { "label": "£", "alternates": ["$", "¢"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "£" } },
        { "label": "¥", "alternates": ["$", "¢"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "¥" } },
        { "label": "¢", "alternates": ["$"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "¢" } },
        { "label": "₹", "alternates": ["$"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "₹" } },
        { "label": "°", "alternates": ["*"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "°" } },
        { "label": "±", "alternates": ["+"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "±" } },
        { "label": "×", "alternates": ["*"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "×" } },
        { "label": "÷", "alternates": ["/"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "÷" } },
        { "label": "≠", "alternates": ["="], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "≠" } }
      ]
    },
    {
      "id": 3,
      "splitIndex": 5,
      "keys": [
        { "label": "123", "style": "modifierKey", "weight": 1.25, "onPress": { "type": "SWITCH_LAYOUT", "target": "mobile_number" }, "onLongPress": { "type": "SWITCH_LAYOUT", "target": "meta" } },
        { "label": "π", "alternates": ["3.14"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "π" } },
        { "label": "√", "alternates": ["^"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "√" } },
        { "label": "¶", "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "¶" } },
        { "label": "∆", "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "∆" } },
        { "label": "•", "alternates": ["*"], "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "•" } },
        { "label": "©", "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "©" } },
        { "label": "®", "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "®" } },
        { "label": "™", "style": "numberKey", "onPress": { "type": "SEND_TEXT", "text": "™" } },
        { "label": "⌫", "style": "actionKey", "flexible": true, "onPress": { "type": "SEND_CODE", "code": 67 }, "onLongPress": { "type": "AUTO_REPEAT", "code": 67, "intervalMs": 50 } }
      ]
    },
    {
      "id": 4,
      "splitIndex": 2,
      "splitKey": true,
      "keys": [
        { "label": "ABC", "style": "modifierKey", "weight": 1.5, "onPress": { "type": "SWITCH_LAYOUT", "target": "mobile" }, "onLongPress": { "type": "SWITCH_LAYOUT", "target": "meta" } },
        { "label": ",", "alternates": ["<", "«"], "style": "alphaKey", "onPress": { "type": "SEND_TEXT", "text": "," } },
        { "label": "␣", "style": "alphaKey", "isSplitKey": true, "splitLeftWeight": 1.0, "splitRightWeight": 3.0, "flexible": true, "onPress": { "type": "SEND_TEXT", "text": " " } },
        { "label": ".", "alternates": [">", "»"], "style": "alphaKey", "onPress": { "type": "SEND_TEXT", "text": "." } },
        { "label": "↵", "style": "actionKey", "weight": 1.5, "onPress": { "type": "SEND_CODE", "code": 66 } }
      ]
    }
  ]
}
