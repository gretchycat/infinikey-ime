{
  "id": "macro",
  "name": "Macro Pad (M1-M25)",
  "version": "0.3.1",
  "author": "Infinikey IME",
  "description": "5 columns by 5 rows of customizable macro keys M1 through M5 (column 1), M6 through M10 (column 2), M11 through M15 (column 3), M16 through M20 (column 4), and M21 through M25 (column 5) with long-press recording.",
  "metadata": {
    "horizontalSpacing": 4,
    "verticalSpacing": 4,
    "defaultScreenMode": "FULL_WIDTH_DOCKED",
    "defaultHeightPercentage": 30,
    "accessoryLayout": "none",
    "showPartial": true
  },
  "theme": {
    "fontFamily": "Monospace"
  },
  "styles": {
    "macroKey": {
      "cornerRadius": 6,
      "bgColor": "#1E293B",
      "fgColor": "#38BDF8",
      "pressedBgColor": "#0284C7"
    },
    "actionKey": {
      "cornerRadius": 6,
      "bgColor": "#0F172A",
      "fgColor": "#F8FAFC"
    }
  },
  "rows": [
    {
      "id": 1,
      "keys": [
        {
          "label": "M1",
          "style": "macroKey",
          "weight": 1.0,
