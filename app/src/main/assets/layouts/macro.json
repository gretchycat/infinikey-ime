{
  "id": "macro",
  "name": "Macro Pad (M1-M10)",
  "version": "1.0.0",
  "author": "Infinikey IME",
  "description": "2 columns by 5 rows of customizable macro keys M1 through M10 with long-press recording.",
  "metadata": {
    "horizontalSpacing": 4,
    "verticalSpacing": 4,
    "defaultScreenMode": "FULL_WIDTH_DOCKED",
    "defaultHeightPercentage": 30,
    "accessoryLayout": "none"
  },
  "theme": {
    "fontFamily": "Monospace"
  },
  "styles": {
    "macroKey": {
      "cornerRadius": 6,
      "bgColor": "#1E293B",
      "fgColor": "#38BDF8",
      "pressedBgColor": "#0284C7"
    },
    "actionKey": {
      "cornerRadius": 6,
      "bgColor": "#0F172A",
      "fgColor": "#F8FAFC"
    }
  },
  "rows": [
    {
      "id": 1,
      "keys": [
        {
          "label": "M1",
          "style": "macroKey",
          "weight": 1.0,
          "onPress": { "type": "MACRO", "id": "M1" },
          "onLongPress": { "type": "MACRO", "id": "M1" }
        },
        {
          "label": "M2",
          "style": "macroKey",
          "weight": 1.0,
          "onPress": { "type": "MACRO", "id": "M2" },
          "onLongPress": { "type": "MACRO", "id": "M2" }
        }
      ]
    },
    {
