{
  "id": "media",
  "name": "Multimedia & Control Pad",
  "version": "0.3.1",
  "_comment": "Multimedia accessory layout featuring volume controls, media playback keys, calculator, web launcher, email, and screen brightness controls with auto-repeating volume, seek, and brightness keys.",
  "author": "Infinikey IME Team",
  "description": "Standalone and accessory multimedia control cluster with volume, playback, app shortcuts, and brightness controls.",
  "metadata": {
    "horizontalSpacing": 4,
    "verticalSpacing": 4,
    "defaultScreenMode": "FULL_WIDTH_DOCKED",
    "defaultHeightPercentage": 30,
    "accessoryLayout": "none"
  },
  "theme": {
    "fontFamily": "Monospace"
  },
  "styles": {
    "mediaKey": {
      "bgColor": "#0F172A",
      "fgColor": "#38BDF8",
      "pressedBgColor": "#1E293B",
      "cornerRadius": 6
    },
    "actionKey": {
      "bgColor": "#0284C7",
      "fgColor": "#FFFFFF",
      "pressedBgColor": "#0369A1",
      "cornerRadius": 6
    },
    "appKey": {
      "bgColor": "#1E293B",
      "fgColor": "#F59E0B",
      "pressedBgColor": "#334155",
      "cornerRadius": 6
    }
  },
  "rows": [
    {
      "id": 1,
      "keys": [
        {
          "label": "⊘",
          "style": "actionKey",
          "weight": 1.0,
          "onPress": { "type": "SEND_CODE", "code": 164 }
        },
        {
          "label": "−",
          "style": "mediaKey",
          "weight": 1.0,
          "onPress": { "type": "SEND_CODE", "code": 25 },
          "onLongPress": { "type": "AUTO_REPEAT", "code": 25, "intervalMs": 50 }
        },
        {
          "label": "+",
          "style": "mediaKey",
          "weight": 1.0,
          "onPress": { "type": "SEND_CODE", "code": 24 },
