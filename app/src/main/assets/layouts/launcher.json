{
  "id": "launcher",
  "name": "App Launcher Grid",
  "version": "0.3.2",
  "_comment": "5x5 Grid App Launcher accessory layout for quick access to installed applications.",
  "author": "Infinikey IME Team",
  "description": "5x5 grid launcher pad featuring application shortcuts with custom app assignment and dynamic application icon rendering.",
  "metadata": {
    "horizontalSpacing": 4,
    "verticalSpacing": 4,
    "defaultScreenMode": "FULL_WIDTH_DOCKED",
    "defaultHeightPercentage": 35,
    "accessoryLayout": "none",
    "showPartial": true
  },
  "theme": {
    "fontFamily": "SansSerif"
  },
  "styles": {
    "launcherKey": {
      "bgColor": "#1E293B",
      "fgColor": "#38BDF8",
      "pressedBgColor": "#334155",
      "cornerRadius": 6
    }
  },
