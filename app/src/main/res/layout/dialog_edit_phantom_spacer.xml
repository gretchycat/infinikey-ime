<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phantom Spacer Width"
        android:textColor="@color/settings_text_header"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adjust the width multiplier of this blank phantom space."
        android:textColor="@color/settings_text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Width Weight (e.g. 0.5, 1.0, 1.5)"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etPhantomWidthWeight"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_spinner_card"
        android:hint="0.5"
        android:inputType="numberDecimal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/settings_text_header"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnConvertToRegularKey"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:backgroundTint="#1E3A5F"
        android:text="🔄 Convert to Regular Key"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDeletePhantomSpacer"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:backgroundTint="#7F1D1D"
        android:text="🗑️ Delete Phantom Spacer"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
