<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Banner & Live Color Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/vLiveColorPreview"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="#38BDF8"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLiveHexCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#38BDF8"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveRgbCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RGB: 56, 189, 248"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>


        <!-- SECTION 1: HSV CONTROLS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 HSV Spectrum &amp; Brightness Controls"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Hue Spectrum Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Hue"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sbHue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="360"
                android:progress="200"
                android:progressTint="#38BDF8"
                android:thumbTint="#38BDF8" />

            <TextView
                android:id="@+id/tvHueVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="200°"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Saturation Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Saturation"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sbSaturation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="75"
                android:progressTint="#38BDF8"
                android:thumbTint="#38BDF8" />

            <TextView
                android:id="@+id/tvSatVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="75%"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Brightness / Value Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Brightness"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sbValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="95"
                android:progressTint="#38BDF8"
                android:thumbTint="#38BDF8" />

            <TextView
                android:id="@+id/tvValVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="95%"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="16dp" />


        <!-- SECTION 2: RGB CHANNELS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎛️ RGB Channel Mixers"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Red Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Red (R)"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbRed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:progress="56"
                android:progressTint="#EF4444"
                android:thumbTint="#EF4444" />

            <TextView
                android:id="@+id/tvRedVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="56"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Green Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Green (G)"
                android:textColor="#22C55E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbGreen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:progress="189"
                android:progressTint="#22C55E"
                android:thumbTint="#22C55E" />

            <TextView
                android:id="@+id/tvGreenVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="189"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Blue Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Blue (B)"
                android:textColor="#3B82F6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbBlue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:progress="248"
                android:progressTint="#3B82F6"
                android:thumbTint="#3B82F6" />

            <TextView
                android:id="@+id/tvBlueVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="248"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="16dp" />


        <!-- SECTION 3: DYNAMIC HARMONY PALETTES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☯️ Generated Color Harmonies, Tints &amp; Shades"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap any generated swatch to select complementary, brighter, or darker variations:"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

        <!-- Brighter Tints Container -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️ Brighter Tints &amp; Pastels:"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layoutTintsContainer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp" />

        <!-- Darker Shades Container -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 Darker Shades:"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layoutShadesContainer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp" />

        <!-- Harmonies Container (Complementary, Analogous, Triadic) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Harmonies (Complementary, Analogous, Triadic):"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layoutHarmoniesContainer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- SECTION 4: ACTIVE THEME PALETTE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Colors Used in Current Theme"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap any existing color swatch to reuse it across key categories:"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/layoutActiveThemeColorsContainer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp" />
    </LinearLayout>
</ScrollView>
