<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ Edit Key Properties"
            android:textColor="@color/settings_text_header"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Primary Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Primary Label (Required)"
            android:textColor="@color/settings_text_sub"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeyPrimaryLabel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="Label (e.g. A, Shift, F1)"
            android:textColorHint="#64748B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Secondary Label (Top Right) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top-Right / Secondary Alternate Label (Optional)"
            android:textColor="@color/settings_text_sub"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeySecondaryLabel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="Secondary (e.g. @, #, $)"
            android:textColorHint="#64748B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Top-Left Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top-Left Corner Label (Optional)"
            android:textColor="@color/settings_text_sub"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeyTopLeftLabel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="Top-Left Label (e.g. F1, Home)"
            android:textColorHint="#64748B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Shift Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shift Active Label (Optional)"
            android:textColor="@color/settings_text_sub"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeyShiftLabel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="Shift Label (e.g. A, ~)"
            android:textColorHint="#64748B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Key Category / Group -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Group Category Style"
            android:textColor="@color/settings_text_sub"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeyCategoryStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Key Graphic / Icon (SVG or User Image) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Graphic Icon (SVG / User Image)"
            android:textColor="@color/settings_text_sub"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Spinner
                android:id="@+id/spEditKeyIcon"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <ImageView
                android:id="@+id/ivEditKeyIconPreview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="#1E293B"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:visibility="visible" />

            <Button
                android:id="@+id/btnBrowseKeyImage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="📁 Browse"
                android:textSize="11sp"
                android:backgroundTint="#1E3A5F"
                android:textColor="#FFFFFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <!-- Width Weight (Default 1.0) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Width Weight (Default 1.0)"
            android:textColor="@color/settings_text_sub"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeyWidthWeight"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="1.0"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/settings_divider"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Access Method Key Actions"
            android:textColor="@color/key_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 1. On Press Action -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. On Tap / Press Action"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeyActionType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeyActionParamSelect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeyActionParam"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="Parameter (e.g. text string or keycode)"
            android:textColorHint="#64748B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- 2. On Long Press Action -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. On Long Press Action"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeyLongPressType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeyLongPressParamSelect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeyLongPressParam"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="Parameter (e.g. repeat keycode, layout name, text)"
            android:textColorHint="#64748B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- 3. On Swipe Up Action -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. On Swipe Up Action"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeySwipeUpType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeySwipeUpParamSelect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeySwipeUpParam"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="Parameter (e.g. text character, keycode)"
            android:textColorHint="#64748B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- 4. On Swipe Down Action -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. On Swipe Down Action"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeySwipeDownType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spEditKeySwipeDownParamSelect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditKeySwipeDownParam"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner_card"
            android:hint="Parameter (e.g. text character, keycode)"
            android:textColorHint="#64748B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/settings_text_header"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Delete Key Button -->
        <Button
            android:id="@+id/btnDeleteKey"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="#7F1D1D"
            android:text="🗑️ Delete Key from Layout"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
